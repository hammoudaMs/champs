# Required in production / Vercel (do not commit real values)
COMPTOIR_PIN_HASH=$2b$10$jn9W1ffAewfAHsQSoTiVku4RfoILogcFxpRTmrYriWH2J.SvR5TW6
COMPTOIR_SECRET=replace-with-long-random-secret
NEXT_PUBLIC_SITE_URL=https://champs-dun.vercel.app

# Durable storage on Vercel (Neon / Vercel Postgres integration)
# Create via Vercel Marketplace → Storage → Postgres/Neon, then link to the project.
POSTGRES_URL=postgresql://user:password@host/db?sslmode=require

# Local development only (ignored if COMPTOIR_PIN_HASH is set)
# COMPTOIR_PIN=2580

# Without POSTGRES_URL locally, data is stored in .data/champs-db.json
# On Vercel without POSTGRES_URL, data is ephemeral (in-memory) — not for production.
